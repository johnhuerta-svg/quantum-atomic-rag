VLLM_ENDPOINT_URL=http://127.0.0.1:8000/v1
VLLM_MODEL_NAME=google/gemma-4-12B-it
EMBEDDING_MODEL_NAME=nomic-embed-text:latest
VLLM_VERSION=0.10.2
VLLM_MODEL_REVISION=main
# Set these only after verifying parser support in the pinned vLLM release.
VLLM_REASONING_PARSER=gemma4
VLLM_TOOL_CALL_PARSER=gemma4
VLLM_GPU_MEMORY_UTILIZATION=0.90
ENABLE_THINKING=false
# HF_TOKEN=
# VLLM_API_KEY=
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5
MAX_PROMPT_BYTES=256000
MAX_RESPONSE_BYTES=2000000

# macOS/Ollama alternative:
# VLLM_ENDPOINT_URL=http://127.0.0.1:11434/v1
# VLLM_MODEL_NAME=gemma4-agent:latest
